# ---------- Main aggregator ----------
def aggregate_jobs():
    all_jobs = []
    sources = [
        ("Indeed", search_indeed),
        ("Glassdoor", search_glassdoor),
        ("NaukriGulf", search_naukrigulf),
        ("RemoteRocketship", search_remote_rocket),
        ("LinkedIn", search_linkedin_public)
    ]
    for region_name, region_q in REGIONS.items():
        for keyword in JOB_KEYWORDS:
            for src_name, func in sources:
                try:
                    items = func(keyword, region_q)
                    # annotate
                    for it in items:
                        it["source"] = src_name
                        it["search_keyword"] = keyword
                        it["region"] = region_name
                        all_jobs.append(it)
                except Exception as e:
                    print(f"[WARN] Source {src_name} failed for {keyword} / {region_q}: {e}")
    # Deduplicate by url or (title+company+location)
    seen = set()
    deduped = []
    for j in all_jobs:
        key = j.get("url") or (j.get("title","") + j.get("company","") + j.get("location",""))
        if key in seen:
            continue
        seen.add(key)
        deduped.append(j)
    return deduped

# ---------- Enrich jobs (fetch JD snippet, extract keywords & skills) ----------
def enrich_jobs(jobs):
    enriched = []
    for j in jobs:
        try:
            summary_text = ""
            if j.get("url"):
                page = safe_get(j["url"])
                if page:
                    soup = BeautifulSoup(page, "lxml")
                    # Try to get description paragraphs
                    desc = soup.find(lambda tag: tag.name in ["div","section"] and ("description" in (tag.get("class") or []) or "jobDescription" in (tag.get("id") or "")))
                    if not desc:
                        # fallback: get big text blocks
                        desc = soup.find("div") or soup.find("body")
                    summary_text = normalize_text(desc.get_text() if desc else "")
            else:
                summary_text = j.get("summary","")
        except Exception:
            summary_text = j.get("summary","")
        # Extract keywords & tech skills
        keywords = extract_top_keywords(summary_text + " " + j.get("title"," ") + " " + j.get("company"," "))
        tech_skills = extract_tech_skills(summary_text + " " + j.get("title"," "))
        enriched.append({
            "Title": j.get("title","").strip(),
            "Company": j.get("company","").strip(),
            "Location": j.get("location","").strip(),
            "URL": j.get("url",""),
            "Source": j.get("source",""),
            "TopKeywords": ", ".join(keywords[:5]),
            "TopTechSkills": ", ".join(tech_skills[:5]),
            "Region": j.get("region",""),
            "SearchKeyword": j.get("search_keyword","")
        })
    return enriched

# ---------- Email builder ----------
def build_html_email(df):
    now = datetime.now().strftime("%d %b %Y %H:%M")
    header = f"<h2>Daily Job Digest — Senior Graphic / Motion / Video Roles</h2><p>Generated: {now} (IST)</p>"
    # convert df to html table with desired columns
    cols = ["Title","Company","Location","URL","TopKeywords","TopTechSkills","Source","Region"]
    html_table = df[cols].to_html(index=False, escape=False, render_links=True)
    note = "<p>Notes: Links are direct job links when available. Some listings may require login on the target site (e.g. LinkedIn).</p>"
    footer = f"<p>Job alert generated for <strong>{html.escape(EMAIL_TO)}</strong></p>"
    return header + html_table + note + footer

# ---------- Email send ----------
def send_email(subject, html_body, attachments=None):
    user = os.environ.get("EMAIL_USER")
    pwd = os.environ.get("EMAIL_PASS")
    if not user or not pwd:
        raise RuntimeError("EMAIL_USER and EMAIL_PASS environment variables must be set.")
    msg = MIMEMultipart()
    msg["From"] = f"{SEND_DISPLAY_NAME} <{EMAIL_FROM}>"
    msg["To"] = EMAIL_TO
    msg["Subject"] = subject
    msg.attach(MIMEText(html_body, "html"))
    # attachments: list of file paths
    if attachments:
        for path in attachments:
            try:
                with open(path, "rb") as f:
                    part = MIMEApplication(f.read(), Name=os.path.basename(path))
                    part['Content-Disposition'] = f'attachment; filename="{os.path.basename(path)}"'
                    msg.attach(part)
            except Exception as e:
                print(f"[WARN] Could not attach {path}: {e}")
    # send via Gmail SMTP
    try:
        server = smtplib.SMTP("smtp.gmail.com", 587)
        server.ehlo()
        server.starttls()
        server.login(user, pwd)
        server.send_message(msg)
        server.quit()
        print("[INFO] Email sent successfully.")
    except Exception as e:
        print(f"[ERROR] Failed to send email: {e}")
        raise

# ---------- Main ----------
def main():
    try:
        print("[INFO] Aggregating jobs...")
        jobs = aggregate_jobs()
        print(f"[INFO] Collected {len(jobs)} raw jobs. Enriching...")
        enriched = enrich_jobs(jobs)
        if not enriched:
            print("[INFO] No jobs found today. Sending empty notice.")
            subject = f"Daily Job Digest — No new matches — {datetime.now().date()}"
            html_body = "<p>No new job matches were found for today. I'll try again tomorrow at 09:00 IST.</p>"
            send_email(subject, html_body)
            return
        df = pd.DataFrame(enriched)
        # For email table: make URL clickable html
        df["URL"] = df["URL"].apply(lambda u: f'<a href="{u}">Apply / View</a>' if u else "")
        html_body = build_html_email(df)
        subject = f"Daily Job Digest: {len(df)} matches — {datetime.now().strftime('%d %b %Y')}"
        # Optionally attach resume if path provided via env ATTACH_RESUME
        attachments = []
        attach_path = os.environ.get("ATTACH_RESUME")
        if attach_path and os.path.exists(attach_path):
            attachments.append(attach_path)
        send_email(subject, html_body, attachments=attachments)
    except Exception as e:
        print("[ERROR] Main failed:", e)
        traceback.print_exc()
        # send failure email to yourself (best effort)
        try:
            subject = "Job Alert Bot — Failure Notification"
            body = f"<p>Error during job aggregation: {html.escape(str(e))}</p><pre>{html.escape(traceback.format_exc())}</pre>"
            send_email(subject, body)
        except Exception:
            pass

if __name__ == "__main__":
    main()
