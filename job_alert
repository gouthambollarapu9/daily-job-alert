# Max results per source per region
MAX_RESULTS_PER_SOURCE = 6

# HTTP
HEADERS = {
    "User-Agent": "Mozilla/5.0 (Windows NT 10.0; Win64; x64) AppleWebKit/537.36 (KHTML, like Gecko) Chrome/120.0 Safari/537.36",
    "Accept-Language": "en-US,en;q=0.9"
}

# Timeout and polite scraping
REQUEST_TIMEOUT = 12
SLEEP_BETWEEN_REQUESTS = 1.2

# ---------- Utilities ----------
def safe_get(url):
    try:
        r = requests.get(url, headers=HEADERS, timeout=REQUEST_TIMEOUT)
        r.raise_for_status()
        time.sleep(SLEEP_BETWEEN_REQUESTS)
        return r.text
    except Exception as e:
        print(f"[WARN] Failed get: {url} -> {e}")
        return ""

def normalize_text(t):
    if not t:
        return ""
    return re.sub(r"\s+", " ", t).strip()

STOPWORDS = set([
    # short list; the script uses simple frequency extraction — for production, swap with nltk/spacy stopwords
    "the","and","or","to","a","of","in","with","for","as","is","on","by","an","be","that","this","are","at","from","we","you","will","experience","years","year"
])

def extract_top_keywords(text, topn=5):
    text = re.sub(r"[^a-zA-Z0-9\s]", " ", text.lower())
    words = [w for w in text.split() if len(w) > 2 and w not in STOPWORDS]
    cn = Counter(words)
    most = [w for w,_ in cn.most_common(topn)]
    return most

def extract_tech_skills(text, topn=5):
    # Look for common design/video tools and return the ones found, otherwise fall back to frequency
    tools = [
        "after effects","premiere pro","premiere","photoshop","illustrator","indesign","figma",
        "davinci","davinci resolve","resolve","final cut","final cut pro","c4d","cinema 4d",
        "blender","ae","pr","audition","audacity","motion","maya","nuke","sfc","html","css",
        "javascript","spline","resolve","lightroom"
    ]
    found = []
    tlower = text.lower()
    for tool in tools:
        if tool in tlower:
            found.append(tool.title().replace("Pr", "Premiere Pro").replace("Ae", "After Effects"))
    # dedupe and limit
    if found:
        uniq = []
        for f in found:
            if f not in uniq:
                uniq.append(f)
        return uniq[:topn]
    # fallback
    return extract_top_keywords(text, topn)

# ---------- Source-specific scrapers ----------
# Each function returns list of dicts: {title, company, location, url, summary_text}
# NOTE: These scrapers target public pages and are intentionally simple — they may break if the target changes.

def search_indeed(query, region_query, max_results=MAX_RESULTS_PER_SOURCE):
    results = []
    # Build search url (Indeed global)
    q = quote_plus(query + " " + region_query)
    url = f"https://www.indeed.com/jobs?q={q}&l="
    html_text = safe_get(url)
    if not html_text:
        return results
    soup = BeautifulSoup(html_text, "lxml")
    cards = soup.select("a.tapItem")[:max_results]
    for a in cards:
        try:
            title = normalize_text(a.select_one("h2.jobTitle").get_text() if a.select_one("h2.jobTitle") else a.get_text())
            company = normalize_text(a.select_one("span.companyName").get_text() if a.select_one("span.companyName") else "")
            location = normalize_text(a.select_one("div.companyLocation").get_text() if a.select_one("div.companyLocation") else region_query)
            href = a.get("href")
            if href and not href.startswith("http"):
                href = "https://www.indeed.com" + href
            summary = ""
            results.append({"title": title, "company": company, "location": location, "url": href, "summary": summary})
        except Exception:
            continue
    return results

